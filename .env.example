# Neon PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Custom Session / JWT Secret (minimum 32 characters)
AUTH_SECRET="tssb_super_secret_session_key_production_32chars_minimum"

# Base URL for authentication and canonical links
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
