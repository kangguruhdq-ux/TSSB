generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ServerType {
  WEB
  DNS
  FILE
  MAIL
  DATABASE
  APPLICATION
  OTHER
}

enum ServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  DEGRADED
  STOPPED
}

enum DocCategory {
  INSTALLATION
  CONFIGURATION
  NETWORKING
  SECURITY
  TROUBLESHOOTING
  MAINTENANCE
  OTHER
}

model User {
  id               String       @id @default(cuid())
  name             String
  username         String       @unique
  email            String       @unique
  passwordHash     String
  avatarUrl        String?
  bio              String?
  role             Role         @default(USER)
  status           UserStatus   @default(ACTIVE)
  securitySettings Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  servers        Server[]
  services       Service[]
  networkConfigs NetworkConfiguration[]
  documentation  Documentation[]
  activityLogs   ActivityLog[]
  files          File[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
}

model Server {
  id              String       @id @default(cuid())
  name            String
  hostname        String
  ipAddress       String
  operatingSystem String
  serverType      ServerType
  location        String
  status          ServerStatus @default(ONLINE)
  description     String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy      User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  services       Service[]
  networkConfigs NetworkConfiguration[]
  documentation  Documentation[]

  @@index([status])
  @@index([serverType])
  @@index([createdById])
}

model Service {
  id          String        @id @default(cuid())
  name        String
  serverId    String
  port        Int
  protocol    String        @default("TCP")
  version     String?
  status      ServiceStatus @default(ACTIVE)
  description String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([status])
  @@index([createdById])
}

model NetworkConfiguration {
  id            String   @id @default(cuid())
  serverId      String
  interfaceName String
  ipAddress     String
  subnetMask    String
  gateway       String
  dnsPrimary    String
  dnsSecondary  String?
  vlan          Int?
  description   String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([createdById])
}

model Documentation {
  id        String      @id @default(cuid())
  title     String
  category  DocCategory
  content   String      @db.Text
  serverId  String?
  authorId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([serverId])
  @@index([authorId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model File {
  id          String   @id @default(cuid())
  userId      String
  name        String
  size        Int      @default(1024)
  mimeType    String   @default("text/plain")
  category    String   @default("DATA")
  description String?
  content     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model FileTransfer {
  id               String   @id @default(cuid())
  senderId         String
  senderName       String
  senderUsername   String
  receiverId       String
  receiverName     String
  receiverUsername String
  fileName         String
  fileSize         Int      @default(1024)
  protocol         String   @default("SFTP")
  port             Int      @default(22)
  status           String   @default("COMPLETED")
  note             String?
  fileContent      String?  @db.Text
  transferredAt    DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([transferredAt])
}

model MailMessage {
  id             String   @id @default(cuid())
  senderId       String
  senderName     String
  senderEmail    String
  recipientId    String
  recipientName  String
  recipientEmail String
  subject        String
  body           String   @db.Text
  priority       String   @default("NORMAL")
  status         String   @default("DELIVERED")
  isRead         Boolean  @default(false)
  hasAttachment  Boolean  @default(false)
  attachmentName String?
  attachments    Json?
  isStarred      Boolean  @default(false)
  isTrash        Boolean  @default(false)
  sentAt         DateTime @default(now())

  @@index([recipientId])
  @@index([senderId])
  @@index([isTrash])
  @@index([sentAt])
}

model SystemSettings {
  id                     String    @id @default("default")
  platformName           String    @default("TSSB Infrastructure Platform")
  maintenanceMode        Boolean   @default(false)
  allowRegistration      Boolean   @default(true)
  loginSuspended         Boolean   @default(false)
  loginSuspensionMessage String    @default("Akses login pengguna saat ini ditangguhkan sementara oleh Administrator untuk pemeliharaan sistem. Silakan coba lagi nanti.")
  sessionTimeoutMinutes  Int       @default(60)
  maxUploadSizeBytes     Float     @default(104857600)
  announcementText       String    @default("System operational. All 5 cluster servers and network routes are active.")
  showAnnouncement       Boolean   @default(true)
  ftpPort                Int       @default(21)
  smtpPort               Int       @default(587)
  imapPort               Int       @default(993)
  storageQuotaDefaultMb  Int       @default(10240)
  lastBackupAt           DateTime?
  updatedAt              DateTime  @updatedAt
}

model Ticket {
  id             String          @id @default(cuid())
  title          String
  category       String          @default("BUG")
  priority       String          @default("NORMAL")
  status         String          @default("OPEN")
  authorId       String
  authorName     String
  authorUsername String
  authorAvatar   String?
  assignedTo     String?
  description    String          @db.Text
  imageUrl       String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  messages TicketMessage[]

  @@index([authorId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  authorId       String
  authorName     String
  authorUsername String
  authorRole     String   @default("USER")
  authorAvatar   String?
  message        String   @db.Text
  imageUrl       String?  @db.Text
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}
